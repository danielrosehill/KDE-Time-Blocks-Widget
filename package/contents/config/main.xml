<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="showLabels" type="Bool">
            <default>true</default>
        </entry>
        <entry name="localLabel" type="String">
            <default>IDT</default>
        </entry>
        <entry name="utcLabel" type="String">
            <default>UTC</default>
        </entry>
        <entry name="autoLocalLabel" type="Bool">
            <default>false</default>
        </entry>
        <entry name="localOnRight" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDivider" type="Bool">
            <default>true</default>
        </entry>
        <entry name="labelPosition" type="String">
            <default>below</default>
        </entry>
        <entry name="showUtcOffset" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showSeconds" type="Bool">
            <default>false</default>
        </entry>
        <entry name="use24Hour" type="Bool">
            <default>true</default>
        </entry>
        <entry name="dateFormat" type="String">
            <default>weekday-short-date</default>
        </entry>
        <entry name="showDateBox" type="Bool">
            <default>true</default>
        </entry>
        <entry name="dateBoxUseUtc" type="Bool">
            <default>false</default>
        </entry>
        <entry name="dateBoxLayout" type="String">
            <default>weekday-top</default>
        </entry>
        <entry name="spacing" type="Int">
            <default>10</default>
        </entry>
        <entry name="desktopPalette" type="String">
            <!-- auto, light, dark, slate, warm, midnight -->
            <default>light</default>
        </entry>
        <entry name="desktopCards" type="Bool">
            <default>true</default>
        </entry>
        <entry name="desktopOrientation" type="String">
            <!-- horizontal or vertical -->
            <default>horizontal</default>
        </entry>
        <entry name="desktopShowContainer" type="Bool">
            <default>false</default>
        </entry>
        <entry name="gregorianDateStyle" type="String">
            <!-- two-line, single-line -->
            <default>two-line</default>
        </entry>
        <entry name="hebrewEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showHebrewDate" type="Bool">
            <default>false</default>
        </entry>
        <entry name="hebrewDateWithYear" type="Bool">
            <default>false</default>
        </entry>
        <entry name="hebrewMonthFirst" type="Bool">
            <default>false</default>
        </entry>
        <entry name="hebrewLatitude" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="hebrewLongitude" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="hebrewTzid" type="String">
            <default></default>
        </entry>
        <entry name="hebrewLocationSet" type="Bool">
            <default>false</default>
        </entry>
        <entry name="hebrewRolloverMode" type="String">
            <!-- Sunset is the only supported mode; civil midnight is used as a silent fallback when no location is set. -->
            <default>sunset</default>
        </entry>
        <entry name="cardOrder" type="String">
            <!-- Desktop blocks (cards). Comma-separated list of block kinds, in display order. -->
            <default>local-time,utc-time,weekday,day,hebrew-day-month</default>
        </entry>
        <entry name="panelCardOrder" type="String">
            <!-- System tray / panel blocks. Same kinds as cardOrder. -->
            <default>local-time,utc-time,date-combined</default>
        </entry>
        <entry name="monthLong" type="Bool">
            <default>false</default>
        </entry>
        <entry name="gregorianDateFormat" type="String">
            <!-- Format of the date line in the combined date card.
                 day        → just the day of month (30)
                 day-month  → "30 Apr" (day before month)
                 month-day  → "Apr 30" (month before day, original)
            -->
            <default>day</default>
        </entry>
        <entry name="localTimeColor" type="String">
            <!-- default | white | yellow | muted | custom -->
            <default>default</default>
        </entry>
        <entry name="localTimeCustomColor" type="String">
            <default>#FFFFFF</default>
        </entry>
        <entry name="utcTimeColor" type="String">
            <!-- default | white | yellow | muted | custom -->
            <default>muted</default>
        </entry>
        <entry name="utcTimeCustomColor" type="String">
            <default>#D9D9D9</default>
        </entry>
        <entry name="extraTimezones" type="String">
            <!-- JSON array: [{"id":"tz_xxx","tzid":"America/New_York","label":"NYC"}, ...] -->
            <default>[]</default>
        </entry>
    </group>
</kcfg>
